#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        td_lbrc: td_lbrc {
            compatible = "zmk,behavior-tap-dance";
            display-name = "LBRC/RBRC Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;
        };

        td_lpar: td_lpar {
            compatible = "zmk,behavior-tap-dance";
            display-name = "LPAR/RPAR Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
        };

        td_lbkt: td_lbkt {
            compatible = "zmk,behavior-tap-dance";
            display-name = "LBKT/RBKT Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };

        bs_bslh: bs_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp BSLH>;
            mods = <(MOD_RSFT)>;
        };

        semi_dqt: semi_dqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp DQT>;
            mods = <(MOD_RSFT)>;
        };

        td_comma_dun: td_comma_dun {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <130>;
            bindings = <&kp COMMA>, <&kp BSLH>;
        };

        tab_tilde: tab_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp TILDE>;
            mods = <(MOD_RSFT)>;
        };

        ctrl_tab: ctrl_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        r_shift_screenshot: r_shift_screenshot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&kp LG(LS(N4))>;
            mods = <(MOD_LSFT)>;
        };

        r_screenshot: r_screenshot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp R>, <&r_shift_screenshot>;
            mods = <(MOD_LGUI)>;
        };

        // Cmd + Q -> Cmd + 1 / Double Cmd + Q -> Cmd + Q
        td_cmd_q: td_cmd_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp Q>;
        };
        q_cmd_morph: q_cmd_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&td_cmd_q>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        // Cmd + W -> Cmd + 2 / Double Cmd + W -> Cmd + W
        td_cmd_w: td_cmd_w {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N2>, <&kp W>;
        };
        w_cmd_morph: w_cmd_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&td_cmd_w>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        // Cmd + E -> Cmd + 3 / Double Cmd + E -> Cmd + E
        td_cmd_e: td_cmd_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N3>, <&kp E>;
        };
        e_cmd_morph: e_cmd_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&td_cmd_e>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };


        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&tab_tilde &q_cmd_morph  &w_cmd_morph  &e_cmd_morph        &r_screenshot &kp T                                   &kp UP      &kp Y  &kp U  &kp I      &kp O    &kp P          &bs_bslh
&ctrl_tab LCTRL LC(SPACE) &kp A  &kp S  &kp D        &kp F    &kp G                          &kp LEFT  &kp ENTER   &kp RIGHT &kp H  &kp J  &kp K      &kp L    &semi_dqt      &kp ENTER
&kp LSHIFT &kp Z  &kp X  &kp C        &kp V    &kp B        &kp SPACE                   &kp DOWN    &kp N  &kp M  &td_comma_dun  &kp DOT  &kp FSLH       &kp RSHIFT
                         &kp LEFT_ALT &kp LGUI &kp SPACE                                            &mo 2  &kp SPACE &mo 1
            >;
        
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "layer1";
            bindings = <
&trans     &trans &trans &mmv MOVE_UP   &trans &trans                                     &trans      &trans   &trans   &trans     &trans   &trans         &trans
&trans     &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans          &trans    &trans      &trans   &kp LEFT &kp DOWN   &kp UP   &kp RIGHT      &kp BACKSPACE    &trans
&trans     &trans &trans &trans         &kp MINUS &trans        &trans                    &trans               &trans   &trans     &kp LBKT &kp RBKT       &kp SQT          &trans
                         &trans         &mkp LCLK &mkp RCLK                                                    &trans   &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "layer2";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH     &kp DLLR &td_lbrc                                 &trans      &kp N7    &kp N8       &kp N9       &kp PLUS     &kp STAR       &kp BSLH
&trans     &kp PRCNT &kp CARET &kp AMPS     &kp SQT &td_lpar                        &trans    &trans      &trans    &kp N4       &kp N5       &kp N6       &kp MINUS       &kp EQUAL      &trans
&trans     &kp SQT   &trans    &trans       &kp LBKT &kp RBKT     &trans                      &trans      &kp N1    &kp N2       &kp N3       &kp DOT      &kp QMARK         &trans
                         &kp EQUAL &kp MINUS &kp PLUS                                                               &trans       &kp N0       &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        control_layer {
            display-name = "layer3";
            bindings = <
&trans     &kp F1       &kp F2       &kp F3       &kp F4   &kp F5                                   &trans      &kp F6     &kp F7         &kp F8         &kp F9          &kp F10        &kp F11
&trans     &trans &trans &trans &trans   &trans                         &trans    &trans      &trans    &trans     &trans         &trans         &trans          &trans         &trans
&trans     &trans       &trans       &trans       &trans   &trans       &trans                      &trans               &trans     &trans         &trans         &trans          &bt BT_CLR_ALL &trans
                                     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2                                                        &trans     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
